# .streamlit/secrets.toml — SALIN ke .streamlit/secrets.toml lalu isi nilainya.
# JANGAN commit secrets.toml ke Git (sudah ada di .gitignore).
#
# The Intrinsic memakai Google Sheets (st-gsheets-connection) untuk worksheet
# "Users" dan "Portfolios". Tidak ada credentials.json di repo — semua kredensial
# Service Account dibaca dari blok [connections.gsheets] di bawah.

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit"
worksheet = "Users"                      # default; kode juga membaca/menulis "Portfolios"
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Penting: pertahankan literal \n di dalam string private_key.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"
client_email = "the-intrinsic@your-project-id.iam.gserviceaccount.com"
client_id = "1234567890..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/the-intrinsic%40your-project-id.iam.gserviceaccount.com"

# Opsional — layanan FastAPI broksum (api.py). Bila diisi, The Engine menarik
# skor broksum dari sini; bila dikosongkan, komponen broksum = netral.
# [broksum]
# api_url = "http://localhost:8000"
