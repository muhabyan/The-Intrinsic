# .streamlit/secrets.toml — SALIN ke .streamlit/secrets.toml lalu isi nilainya.
# JANGAN commit secrets.toml ke Git (sudah ada di .gitignore).

[supabase]
url = "https://xxxxxxxxxxxx.supabase.co"   # Project URL (Settings > API)
key = "eyJhbGciOi..."                       # anon public key (BUKAN service_role di klien)

[authenticator]
cookie_name = "the_intrinsic_auth"
cookie_key = "ganti_dengan_string_acak_panjang_dan_rahasia"  # python -c "import secrets; print(secrets.token_hex(32))"
cookie_expiry_days = 30

# Opsional — bila layanan FastAPI broksum (api.py) dijalankan.
# Jika diisi, broksum_score() di app.py akan menarik skor dari API ini;
# jika dikosongkan / dihapus, app.py membaca tabel broker_summary langsung.
[broksum]
api_url = "http://localhost:8000"
